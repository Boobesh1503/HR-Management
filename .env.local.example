# ============================================
# Neon PostgreSQL Database (neon.tech)
# ============================================
DATABASE_URL="postgresql://username:password@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require"
# ============================================
# Cloudinary Resume File Storage (cloudinary.com)
# ============================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ============================================
# App
# ============================================
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"

